### Copy for local dev:
### cp .env.dev.example .env.dev

### Backend (run from IDE / GoLand)
PORT=8080
SHARE_DATA=true
DATABASE_URL=postgres://heimly_backend:supersecretpassword@localhost:5432/heimly?sslmode=disable
CACHE_URL=redis://localhost:6379/0
STORAGE_URL=http://localhost:9000

### Infra (used by docker-compose.dev.yml)
POSTGRES_USER=heimly_backend
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=heimly
POSTGRES_PORT=5432
VALKEY_PORT=6379
RUSTFS_ACCESS_KEY=heimly_backend
RUSTFS_SECRET_KEY=supersecretpassword
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
DOCS_PORT=8081
NETWORK_NAME=heimly_dev_net
