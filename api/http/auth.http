# Select `local` or `docker` environment from `api/http/http-client.env.json`.
@login = demo{{$timestamp}}
@email = demo{{$timestamp}}@example.com
@name = Demo User
@password = demo-pass-123

### Register (stores JWT to client.global token)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "login": "{{login}}",
  "email": "{{email}}",
  "name": "{{name}}",
  "password": "{{password}}",
  "birthday": "1995-10-15"
}

> {%
  if (response.status === 200 && response.body && response.body.access_token) {
    client.global.set("token", response.body.access_token);
  }
%}

### Login (refreshes JWT in client.global token)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

> {%
  if (response.status === 200 && response.body && response.body.access_token) {
    client.global.set("token", response.body.access_token);
  }
%}

### Current user profile (requires token)
GET {{baseUrl}}/api/v1/users/me
Accept: application/json
Authorization: Bearer {{token}}
