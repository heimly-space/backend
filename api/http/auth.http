# Select `local` or `docker` environment from `api/http/http-client.env.json`.
@login = alice{{$timestamp}}
@email = alice{{$timestamp}}@example.com
@name = Alice Liddell
@password = cheshire-smile-123
@householdsCursor =
@membersCursor =
@tasksCursor =
@taskId =

### Register (stores access + refresh tokens)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json
Accept: application/json

{
  "login": "{{login}}",
  "email": "{{email}}",
  "name": "{{name}}",
  "password": "{{password}}",
  "birthday": "1995-10-15"
}

> {%
  if (response.status === 200 && response.body) {
    if (response.body.access_token) client.global.set("token", response.body.access_token);
    if (response.body.refresh_token) client.global.set("refreshToken", response.body.refresh_token);
  }
%}

### Login (refreshes access + refresh tokens)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

> {%
  if (response.status === 200 && response.body) {
    if (response.body.access_token) client.global.set("token", response.body.access_token);
    if (response.body.refresh_token) client.global.set("refreshToken", response.body.refresh_token);
  }
%}

### Refresh access token by refresh token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refresh_token": "{{refreshToken}}"
}

> {%
  if (response.status === 200 && response.body) {
    if (response.body.access_token) client.global.set("token", response.body.access_token);
    if (response.body.refresh_token) client.global.set("refreshToken", response.body.refresh_token);
  }
%}

### Logout current session
POST {{baseUrl}}/api/v1/auth/logout
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "refresh_token": "{{refreshToken}}"
}

### Current user profile (requires token)
GET {{baseUrl}}/api/v1/users/me
Accept: application/json
Authorization: Bearer {{token}}

### Create household
POST {{baseUrl}}/api/v1/households
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "Wonderland Flat {{$timestamp}}"
}

> {%
  if (response.status === 201 && response.body && response.body.id) {
    client.global.set("householdId", response.body.id);
  }
%}

### List my households (cursor pagination)
GET {{baseUrl}}/api/v1/households?limit=20&cursor={{householdsCursor}}
Accept: application/json
Authorization: Bearer {{token}}

> {%
  if (response.status === 200 && response.body) {
    client.global.set("householdsCursor", response.body.next_cursor || "");
  }
%}

### Invite member to household by email
POST {{baseUrl}}/api/v1/households/{{householdId}}/members
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "email": "rabbit@example.com"
}

### List household members (cursor pagination)
GET {{baseUrl}}/api/v1/households/{{householdId}}/members?limit=20&cursor={{membersCursor}}
Accept: application/json
Authorization: Bearer {{token}}

> {%
  if (response.status === 200 && response.body) {
    client.global.set("membersCursor", response.body.next_cursor || "");
  }
%}

### Create household task
POST {{baseUrl}}/api/v1/households/{{householdId}}/tasks
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "title": "Paint the white roses",
  "description": "Bring red paint before the Queen arrives",
  "status": "pending",
  "due_at": "2026-03-01",
  "assignee_ids": []
}

> {%
  if (response.status === 201 && response.body && response.body.id) {
    client.global.set("taskId", response.body.id);
  }
%}

### List household tasks (cursor pagination + optional filters)
GET {{baseUrl}}/api/v1/households/{{householdId}}/tasks?status=pending&limit=20&cursor={{tasksCursor}}
Accept: application/json
Authorization: Bearer {{token}}

> {%
  if (response.status === 200 && response.body) {
    client.global.set("tasksCursor", response.body.next_cursor || "");
  }
%}

### Update task
PATCH {{baseUrl}}/api/v1/tasks/{{taskId}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "status": "done",
  "assignee_ids": null
}

### Delete task
DELETE {{baseUrl}}/api/v1/tasks/{{taskId}}
Accept: application/json
Authorization: Bearer {{token}}
