### Copy this file to `.env` for self-hosted run
### cp example.env .env

### Heimly
HEIMLY_PORT=8080
SHARE_DATA=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

### PostgreSQL
POSTGRES_USER=heimly_backend
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=heimly

### RustFS
RUSTFS_ACCESS_KEY=heimly_backend
RUSTFS_SECRET_KEY=supersecretpassword
