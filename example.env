### Self-hosted env template (legacy path).
### Prefer using `.env.example`:
### cp .env.example .env

### Heimly
HEIMLY_PORT=8080
SHARE_DATA=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

### PostgreSQL
POSTGRES_USER=heimly_backend
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=heimly
POSTGRES_PORT=5432

### Valkey
VALKEY_PORT=6379

### RustFS
RUSTFS_ACCESS_KEY=heimly_backend
RUSTFS_SECRET_KEY=supersecretpassword
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

### Heimly network
NETWORK_NAME=heimly_net
